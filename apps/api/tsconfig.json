{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": true,
    "noEmit": false,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/db" }
  ]
}
